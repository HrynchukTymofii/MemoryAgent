# The application's own OAuth credentials, baked into the binary at build time.
#
# These identify this app to Google. They are the same for every user and no
# user ever sees them. Copy this file to `.env` and fill it in; `.env` is
# gitignored.
#
# Google Cloud console -> APIs & Services -> Credentials
#   -> Create OAuth client ID -> application type: Desktop app
#
# Google issues a secret even for desktop clients and its token endpoint
# requires it. It ships inside every copy of the binary and is documented by
# Google as not confidential for installed apps; PKCE is what protects the
# exchange. Keep it out of git anyway.
MEMOS_GOOGLE_CLIENT_ID=
MEMOS_GOOGLE_CLIENT_SECRET=

# Base URL of our own API (cloud/). Signing in exchanges the Google token for a
# session with it, and it is the only thing that talks to Postgres.
#   local: http://127.0.0.1:8000
# Leave empty and the app signs in locally and records nothing.
MEMOS_API_URL=

# Direct Postgres connection string, for applying cloud/migrations only.
# A DEVELOPER credential: used by scripts/migrate-cloud.ps1 on your machine,
# never compiled into the app and never shipped. The app holds no connection
# string — it authenticates as the signed-in user through the Data API.
DATABASE_URL=

# --- API only (cloud/) ------------------------------------------------------
GOOGLE_CLIENT_ID=          # same value as MEMOS_GOOGLE_CLIENT_ID
SESSION_SECRET=            # 32+ random characters; rotating signs everyone out

# Email sign-in. Any SMTP provider — Resend, Postmark, SES, Gmail.
# Empty host disables email sign-in; the app then offers Google only.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_SSL=false             # true for port 465, false for 587 (STARTTLS)

# Referrals.
#
# PUBLIC_URL is where the invite link points, so it has to be an address that
# works from a stranger's phone — not 127.0.0.1. Until this is a real host, the
# link shown in the app is a placeholder that will not resolve.
PUBLIC_URL=                # e.g. https://api.memoryos.app
# Where /r/{code} sends someone who has not installed the app yet. Empty and
# that endpoint answers 503 rather than redirecting to a page that is not there.
DOWNLOAD_URL=
# What a referee has to dictate before either side is paid, and how long after
# signing up an account may still apply somebody's code. Defaults shown.
REFERRAL_QUALIFY_WORDS=2000
REFERRAL_WINDOW_DAYS=30
REFERRAL_MONTHS=1
REFERRAL_INVITES_PER_DAY=20

# --- macOS distribution (scripts/build-macos.sh) ----------------------------
# Only needed to hand a build to someone else. Building and running locally
# needs nothing from Apple.
APPLE_SIGNING_IDENTITY=     # "Developer ID Application: Your Name (TEAMID)"
APPLE_TEAM_ID=
# Either an App Store Connect API key (preferred — does not expire in six months)
APPLE_API_ISSUER=
APPLE_API_KEY=
APPLE_API_KEY_PATH=         # path to the .p8
# ...or an Apple ID with an app-specific password from appleid.apple.com
APPLE_ID=
APPLE_PASSWORD=

# --- Routing ----------------------------------------------------------------
# The key the router uses (ADR-0011). Every spoken command that is not a
# formulaic one goes to Claude with the action space attached; without a key the
# app falls back to the built-in grammar, which handles the familiar phrasings
# and nothing else.
#
# Unlike everything else in this file, this one is read at RUN time, not baked
# in at build time — a key that bills somebody does not belong inside a binary.
# The app looks in this order: the environment, this file, then
# `anthropic_api_key` in config.json beside the database. An installed copy has
# no .env near it and uses config.json, which is where a user's own key goes.
ANTHROPIC_API_KEY=
