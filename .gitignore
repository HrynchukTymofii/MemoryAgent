# Rust
/target
**/target
Cargo.lock.bak

# Node
node_modules/
dist/
.vite/
*.tsbuildinfo

# Python (cloud tier)
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/

# Model weights — never commit, fetched by scripts/fetch-models.ps1 (Windows)
# or scripts/fetch-models.sh (macOS, Linux)
/models/**/*.bin
/models/**/*.gguf
/models/**/*.onnx
/models/**/*.safetensors

# Staged into the installer by `fetch-models.ps1 bundle` / `fetch-models.sh
# bundle`. Copies of files that are already gitignored above, so they are
# gitignored here too; the directories themselves are tracked, because the
# bundler is pointed at them whether or not a build has staged anything yet.
/apps/desktop/src-tauri/resources/**/*.bin
/apps/desktop/src-tauri/resources/**/*.onnx
/apps/desktop/src-tauri/resources/**/*.json
/apps/desktop/src-tauri/resources/**/*.dll
/apps/desktop/src-tauri/resources/**/*.dylib
/apps/desktop/src-tauri/resources/**/*.so

# The ONNX Runtime is fetched by the same script. The Windows DLLs beside it
# predate that script and stay tracked; nothing new joins them.
/runtime/*.dylib
/runtime/*.so

# Local data & secrets
*.db
*.db-wal
*.db-shm
.env
.env.*
!.env.example

# OS
.DS_Store
Thumbs.db
!.env.example
